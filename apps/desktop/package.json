    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "33.4.11",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
