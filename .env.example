# 复制为 .env 后只在网关进程所在机器上填写。不要写入桌面渲染进程、手机包或仓库。
# cp .env.example .env

# 网关
PA_HOST=127.0.0.1
PA_PORT=47471
PA_DATA_DIR=./data
# 绑定非回环地址时必须同时显式打开，否则进程拒绝启动。局域网没有 TLS。
PA_ALLOW_UNSAFE_LAN=0
PA_FIXTURES_DIR=./fixtures
PA_CORS_ORIGIN=http://127.0.0.1:47331

# 实况模型。留空则只能使用 demo。demo 不会读取这些值去发起网络请求，也不会在缺少密钥时自动改走实况。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 预算与时限
PA_TOOL_BUDGET=30
PA_MAX_MODEL_STEPS=30
PA_EXECUTION_BUDGET_MS=120000
PA_TOOL_TIMEOUT_MS=20000
PA_APPROVAL_TTL_MS=600000
PA_CURSOR_TTL_MS=86400000
PA_PAIRING_TTL_MS=300000
PA_DEVICE_TOKEN_TTL_MS=2592000000
PA_SWEEP_MS=1000

# 测试故障钩子。生产必须保持关闭。
PA_TEST_HOOKS=0

# 可选：实况模型测试。默认测试不会读取密钥，也不会调用供应商。
# PA_LIVE_LLM=1
